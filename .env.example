# Values belong in Render / cloud environment settings. No dotenv loader is used.
DISCORD_TOKEN=
CHANNEL_ID=
LOGS=
KMA_KEY=
SAFETY_KEY=
# Optional server consistency check; normally inferred from CHANNEL_ID.
GUILD_ID=
# Use a dedicated directory on a persistent disk in production.
DATA_DIR=.data
# Explicit opt-in; default alerts do not ping everyone.
ALERT_MENTION_EVERYONE=false
PORT=3000
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
